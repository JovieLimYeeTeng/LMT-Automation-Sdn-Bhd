  "buildCommand": "cd prototype/tms-hr-prototype && npm run build",
  "outputDirectory": "prototype/tms-hr-prototype/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
